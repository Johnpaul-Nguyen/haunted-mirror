# Copy to .env and fill in. Leave SPIRIT_API_KEY empty to use the offline spirit.

# DigitalOcean Gradient serverless inference (default)
SPIRIT_BASE_URL=https://inference.do-ai.run/v1
SPIRIT_API_KEY=
SPIRIT_MODEL=deepseek-v4.1-flash

# Or a local model with Ollama:
# SPIRIT_BASE_URL=http://localhost:11434/v1
# SPIRIT_API_KEY=ollama
# SPIRIT_MODEL=llama3.2:3b

SPIRIT_CITY=Norman, OK
# Leave blank to use the first camera that gives frames, or set an index (ls /dev/video*)
SPIRIT_CAMERA=
SPIRIT_PORT=8666

# Time zone for the greeting (the UNO Q defaults to UTC)
TZ=America/Chicago
